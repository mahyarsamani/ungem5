# The lab worker, one per machine: it launches each job as its owner, in a
# transient unit of its own in experiment-<owner>.slice. Jobs are their own
# units, so they outlive restarts of this one.
[Unit]
Description=experiment worker (launches lab jobs as their owners)
Wants=network-online.target
After=network-online.target remote-fs.target sssd.service

[Service]
# NOTE: The port and who may run jobs come from /etc/experiment/config.toml.
ExecStart=/opt/experiment/venv/bin/helper work --name %H
Environment=EXPERIMENT_PKI_DIR=/etc/experiment/pki
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
