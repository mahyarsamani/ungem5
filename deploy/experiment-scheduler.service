# The lab scheduler, on one machine (liberty). It runs as the system account
# `experiment`, never runs users' code, and takes commands from members of
# coe-us-cs-darchr over /run/experiment/scheduler.sock.
[Unit]
Description=experiment lab scheduler
Wants=network-online.target
After=network-online.target remote-fs.target sssd.service

[Service]
User=experiment
Group=experiment
# NOTE: The name, socket, port, groups and admins come from
# /etc/experiment/config.toml.
ExecStart=/opt/experiment/venv/bin/python -m experiment.api.scheduler.daemon --lab
# NOTE: /run/experiment holds the socket that everyone opens; the lock lives
# in its private subdirectory, and the state in /var/lib/experiment.
RuntimeDirectory=experiment
RuntimeDirectoryMode=0755
StateDirectory=experiment
Environment=XDG_STATE_HOME=/var/lib/experiment
Environment=EXPERIMENT_RUNTIME_DIR=/run/experiment/private
Environment=EXPERIMENT_PKI_DIR=/etc/experiment/pki
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
